  "withdrawn_abort_condition": {
    "0.55": {
      "source": "ROUND5_DANN_DESIGN.md 6, abort condition 3",
      "was_it_invented": "NO. PROJECT_STATE v2.md 6 and 8/F4 record the trained HEAD's morphology AUROC falling ~0.61 -> ~0.37 under plain DANN and ~0.33 under IW-CDAN. 0.55 sat just under that real ~0.61 baseline. Briefs v3 and v4 asserted it was invented; that came from searching PROJECTv6.md alone and reading absence from one document as absence from the record.",
      "why_withdrawn": "it is meaningless on the FROZEN-PROBE column, which reads ~0.92. It was never wrong for its own instrument."
    },
    "0.6910": {
      "source": "brief v2, a rescaling of 0.55 onto the probe column by fraction of headroom over chance",
      "why_withdrawn": "rescaling a threshold across a change of instrument assumes the two measure the same thing. They do not -- they read ~0.34 apart at step 0."
    },
    "0.10": {
      "source": "brief v3, the control-referenced margin",
